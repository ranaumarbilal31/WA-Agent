# Optional server defaults — the Setup UI (BYOK) overrides all of these per user.
# LLM provider: gemini | openai | anthropic | xai | openrouter | ollama | lmstudio | custom
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Legacy fallback (maps to provider=gemini)
GEMINI_API_KEY=
PORT=3000
# Optional: path to your own Chromium-based browser (Chrome, Edge, Brave, Opera, Vivaldi).
# If empty, the app auto-detects common install locations.
# Example (Windows): CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
# Comma-separated list of your sender names/aliases as they appear in exports
# e.g. "Master,Master (You),+92 300 1234567"
MY_IDENTIFIERS=
